<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Gru Command — launchd unit template. install.sh renders
     {{NODE}}, {{REPO_ROOT}}, and {{GRU_COMMAND_HOME}} to absolute paths
     and installs to ~/Library/LaunchAgents. KeepAlive restarts the
     service on crash (a clean exit(0) — a manual stop — stays down,
     SPEC ruling 5: the OS service manager is the out-of-band watcher). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gru-command.service</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{REPO_ROOT}}/dist/main.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>GRU_COMMAND_HOME</key>
    <string>{{GRU_COMMAND_HOME}}</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>{{GRU_COMMAND_HOME}}/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{GRU_COMMAND_HOME}}/logs/launchd.err.log</string>

  <key>ThrottleInterval</key>
  <integer>5</integer>
</dict>
</plist>
