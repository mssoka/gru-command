# Gru Command — systemd USER unit template. install.sh renders
# {{NODE}}, {{REPO_ROOT}}, {{GRU_COMMAND_HOME}}, and {{PATH}} at install time
# and installs to ~/.config/systemd/user/. Restart=on-failure restarts the
# service on crash (a clean exit(0) — a manual stop — stays down, SPEC
# ruling 5: the OS service manager is the out-of-band watcher).
#
# Note: a user unit runs while the user is logged in. For an always-on
# machine enable lingering:  loginctl enable-linger $USER

[Unit]
Description=Gru Command — multi-agent orchestrator service
X-GruCommandManagedBy=gru-command-install-v2
After=network-online.target

[Service]
Type=simple
ExecStart={{NODE}} {{REPO_ROOT}}/dist/main.js
Environment=GRU_COMMAND_HOME={{GRU_COMMAND_HOME}}
# Keep the installed Node/npm bin on PATH for job bootstrap and verification
# even when the service manager did not inherit the user's shell setup.
Environment="PATH={{PATH}}"
Restart=on-failure
RestartSec=2
# The service writes its own structured log under the instance data dir;
# systemd captures stdout/stderr as a convenience mirror.
SyslogIdentifier=gru-command

[Install]
WantedBy=default.target
